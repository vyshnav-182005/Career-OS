{
  "name": "career-os",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "venv\\Scripts\\python -m uvicorn backend.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:python": "venv\\Scripts\\pip install -r backend\\requirements.txt",
    "setup": "npm install && npm run install:frontend && python -m venv venv && npm run install:python"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
